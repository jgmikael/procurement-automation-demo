<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VAT Identification - WE BUILD Credential Example</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            max-width: 900px;
            width: 100%;
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 40px;
            text-align: center;
            position: relative;
        }

        .header::before {
            content: '🏛️';
            font-size: 64px;
            display: block;
            margin-bottom: 20px;
            opacity: 0.9;
        }

        .header h1 {
            font-size: 32px;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .header .subtitle {
            font-size: 16px;
            opacity: 0.95;
            margin-top: 8px;
        }

        .badge {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            padding: 8px 20px;
            border-radius: 20px;
            font-size: 14px;
            margin-top: 15px;
            border: 1px solid rgba(255,255,255,0.3);
        }

        .content {
            padding: 40px;
        }

        .section {
            margin-bottom: 35px;
            padding-bottom: 35px;
            border-bottom: 2px solid #f0f0f0;
        }

        .section:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .section-title {
            font-size: 20px;
            color: #2a5298;
            margin-bottom: 20px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .field-group {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .field {
            background: #f8f9fa;
            padding: 18px;
            border-radius: 12px;
            border-left: 4px solid #2a5298;
        }

        .field-label {
            font-size: 12px;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .field-value {
            font-size: 16px;
            color: #222;
            font-weight: 500;
            word-break: break-word;
        }

        .field-value.large {
            font-size: 24px;
            color: #2a5298;
            font-weight: 700;
            font-family: 'Courier New', monospace;
        }

        .validity-period {
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            padding: 20px;
            border-radius: 12px;
            border-left: 4px solid #4caf50;
        }

        .validity-period.expired {
            background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
            border-left-color: #f44336;
        }

        .activity-card {
            background: #fff8e1;
            padding: 18px;
            border-radius: 12px;
            margin-bottom: 15px;
            border-left: 4px solid #ffa726;
        }

        .activity-card:last-child {
            margin-bottom: 0;
        }

        .activity-code {
            font-family: 'Courier New', monospace;
            font-weight: 700;
            color: #e65100;
            font-size: 18px;
            margin-bottom: 8px;
        }

        .activity-desc {
            color: #555;
            line-height: 1.6;
            margin-top: 8px;
        }

        .credential-json {
            background: #1e1e1e;
            color: #d4d4d4;
            padding: 25px;
            border-radius: 12px;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            overflow-x: auto;
            line-height: 1.6;
            max-height: 600px;
            overflow-y: auto;
        }

        .json-key {
            color: #9cdcfe;
        }

        .json-string {
            color: #ce9178;
        }

        .json-number {
            color: #b5cea8;
        }

        .json-boolean {
            color: #569cd6;
        }

        .button {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 35px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 16px;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }

        .button-group {
            display: flex;
            gap: 15px;
            margin-top: 25px;
            flex-wrap: wrap;
        }

        .info-box {
            background: #e3f2fd;
            border-left: 4px solid #2196f3;
            padding: 20px;
            border-radius: 8px;
            margin: 25px 0;
        }

        .info-box-title {
            font-weight: 700;
            color: #1565c0;
            margin-bottom: 10px;
            font-size: 16px;
        }

        .info-box-content {
            color: #555;
            line-height: 1.7;
        }

        .info-box ul {
            margin-left: 20px;
            margin-top: 10px;
        }

        .info-box li {
            margin-bottom: 8px;
        }

        .issuer-box {
            background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
            padding: 25px;
            border-radius: 12px;
            margin-top: 20px;
        }

        .issuer-logo {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            border-bottom: 2px solid #e0e0e0;
        }

        .tab {
            padding: 12px 24px;
            cursor: pointer;
            border: none;
            background: none;
            font-size: 16px;
            font-weight: 500;
            color: #666;
            transition: all 0.3s;
            border-bottom: 3px solid transparent;
        }

        .tab.active {
            color: #2a5298;
            border-bottom-color: #2a5298;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-active {
            background: #c8e6c9;
            color: #2e7d32;
        }

        .status-warning {
            background: #fff9c4;
            color: #f57f17;
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 24px;
            }
            
            .field-group {
                grid-template-columns: 1fr;
            }

            .button-group {
                flex-direction: column;
            }

            .button {
                width: 100%;
                text-align: center;
            }
        }

        .cross-border-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: #e8f5e9;
            border: 2px solid #4caf50;
            border-radius: 25px;
            font-weight: 600;
            color: #2e7d32;
            margin-top: 15px;
        }

        .cross-border-badge::before {
            content: '✓';
            font-size: 20px;
            color: #4caf50;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>VAT Identification</h1>
            <div class="subtitle">Value Added Tax Registration Certificate</div>
            <div class="badge">QEAA Qualified Electronic Attestation of Attributes</div>
        </div>

        <div class="content">
            <div class="tabs">
                <button class="tab active" onclick="showTab('human')">👤 Human-Readable</button>
                <button class="tab" onclick="showTab('technical')">⚙️ Technical View</button>
                <button class="tab" onclick="showTab('json')">💻 W3C VC JSON</button>
            </div>

            <div id="human-tab" class="tab-content active">
                <!-- VAT ID Section -->
                <div class="section">
                    <div class="section-title">🆔 VAT Identification Number</div>
                    <div class="field">
                        <div class="field-label">VAT ID</div>
                        <div class="field-value large">NL123456789B01</div>
                    </div>
                    <div class="field-group">
                        <div class="field">
                            <div class="field-label">Administrative Unit Name</div>
                            <div class="field-value">TechFlow Solutions B.V.</div>
                        </div>
                        <div class="field">
                            <div class="field-label">Organisation Type</div>
                            <div class="field-value">Besloten Vennootschap (B.V.)</div>
                        </div>
                    </div>
                    <div class="cross-border-badge">
                        Registered for EU Cross-Border Transactions
                    </div>
                </div>

                <!-- Validity Period -->
                <div class="section">
                    <div class="section-title">📅 Validity Period</div>
                    <div class="validity-period">
                        <div class="field-group">
                            <div class="field" style="background: white; border-left-color: #4caf50;">
                                <div class="field-label">Valid From</div>
                                <div class="field-value">2020-03-15</div>
                            </div>
                            <div class="field" style="background: white; border-left-color: #4caf50;">
                                <div class="field-label">Valid Until</div>
                                <div class="field-value">No expiry date</div>
                            </div>
                        </div>
                        <div style="margin-top: 15px; color: #2e7d32; font-weight: 600;">
                            <span class="status-badge status-active">✓ Currently Valid</span>
                        </div>
                    </div>
                </div>

                <!-- Economic Operator -->
                <div class="section">
                    <div class="section-title">🏢 Economic Operator (Legal Person)</div>
                    <div class="field-group">
                        <div class="field">
                            <div class="field-label">Legal Identifier (EUID)</div>
                            <div class="field-value">NLKVK.90517428</div>
                        </div>
                        <div class="field">
                            <div class="field-label">Legal Name</div>
                            <div class="field-value">TechFlow Solutions B.V.</div>
                        </div>
                    </div>
                </div>

                <!-- Address -->
                <div class="section">
                    <div class="section-title">📍 Registered Address</div>
                    <div class="field-group">
                        <div class="field">
                            <div class="field-label">Street Address</div>
                            <div class="field-value">Herengracht 450</div>
                        </div>
                        <div class="field">
                            <div class="field-label">Postal Code</div>
                            <div class="field-value">1017 CA</div>
                        </div>
                        <div class="field">
                            <div class="field-label">City</div>
                            <div class="field-value">Amsterdam</div>
                        </div>
                        <div class="field">
                            <div class="field-label">Province</div>
                            <div class="field-value">North Holland</div>
                        </div>
                        <div class="field">
                            <div class="field-label">Country</div>
                            <div class="field-value">Netherlands (NL)</div>
                        </div>
                    </div>
                </div>

                <!-- Economic Activities -->
                <div class="section">
                    <div class="section-title">🏭 Economic Activities</div>
                    
                    <div class="activity-card">
                        <div class="activity-code">NACE Rev. 2.1: J62.01</div>
                        <div class="field-label">Nomenclature Version</div>
                        <div class="field-value">Rev. 2.1</div>
                        <div class="activity-desc">
                            <strong>Description:</strong><br>
                            <strong>EN:</strong> Computer programming activities<br>
                            <strong>NL:</strong> Ontwikkelen van computerprogramma's
                        </div>
                    </div>

                    <div class="activity-card">
                        <div class="activity-code">NACE Rev. 2.1: J62.02</div>
                        <div class="field-label">Nomenclature Version</div>
                        <div class="field-value">Rev. 2.1</div>
                        <div class="activity-desc">
                            <strong>Description:</strong><br>
                            <strong>EN:</strong> Computer consultancy activities<br>
                            <strong>NL:</strong> Advisering op het gebied van informatietechnologie
                        </div>
                    </div>

                    <div class="activity-card">
                        <div class="activity-code">SBI 2008: 6201</div>
                        <div class="field-label">Nomenclature</div>
                        <div class="field-value">SBI (Dutch Standard Industrial Classification)</div>
                        <div class="activity-desc">
                            <strong>Description:</strong><br>
                            <strong>NL:</strong> Ontwikkelen, produceren en uitgeven van software
                        </div>
                    </div>
                </div>

                <!-- Issuer Information -->
                <div class="section">
                    <div class="section-title">🏛️ Issuer Information</div>
                    <div class="issuer-box">
                        <div class="issuer-logo">🇳🇱</div>
                        <div class="field-group">
                            <div class="field" style="background: white;">
                                <div class="field-label">Authentic Source</div>
                                <div class="field-value">Belastingdienst</div>
                            </div>
                            <div class="field" style="background: white;">
                                <div class="field-label">Issuing Authority</div>
                                <div class="field-value">Dutch Tax and Customs Administration</div>
                            </div>
                            <div class="field" style="background: white;">
                                <div class="field-label">Country</div>
                                <div class="field-value">Netherlands (NL)</div>
                            </div>
                            <div class="field" style="background: white;">
                                <div class="field-label">Issuance Date</div>
                                <div class="field-value">2026-09-07</div>
                            </div>
                            <div class="field" style="background: white;">
                                <div class="field-label">Attestation Expires</div>
                                <div class="field-value">2027-09-07</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Use Cases -->
                <div class="info-box">
                    <div class="info-box-title">📋 Attestation Use Cases</div>
                    <div class="info-box-content">
                        This VAT Identification attestation can be used for:
                        <ul>
                            <li><strong>Public Procurement:</strong> Prove VAT registration without paper certificates</li>
                            <li><strong>Intra-EU Trade:</strong> Verify VAT ID for cross-border transactions without VIES lookup</li>
                            <li><strong>Tender Procedures:</strong> Digital submission replacing scanned paper certificates</li>
                            <li><strong>Business Onboarding:</strong> Verify company VAT status for B2B relationships</li>
                            <li><strong>Tax Compliance:</strong> Demonstrate valid VAT registration to customers and partners</li>
                        </ul>
                    </div>
                </div>

                <!-- EBWV Mapping -->
                <div class="info-box" style="background: #f3e5f5; border-left-color: #9c27b0;">
                    <div class="info-box-title" style="color: #6a1b9a;">🔗 EBWV Vocabulary Mapping</div>
                    <div class="info-box-content">
                        <strong>Key EBWV Concepts Used:</strong>
                        <ul>
                            <li><code>ebwv:VATRegistrationUnit</code> - Administrative unit holding VAT ID</li>
                            <li><code>ebwv:identifier</code> - VAT identification number</li>
                            <li><code>ebwv:EconomicOperator</code> - Entity responsible for economic operations</li>
                            <li><code>ebwv:LegalPerson</code> - Legal entity (company)</li>
                            <li><code>ebwv:legalIdentifier</code> - EUID (European Unique Identifier)</li>
                            <li><code>ebwv:legalName</code> - Registered company name</li>
                            <li><code>ebwv:address</code> - Postal address components</li>
                            <li><code>ebwv:activity</code> - Economic activity classification (NACE/SBI)</li>
                        </ul>
                    </div>
                </div>

                <div class="button-group">
                    <a href="../index.html" class="button">← Back to Index</a>
                    <button class="button" onclick="showTab('json')">View W3C VC JSON →</button>
                </div>
            </div>

            <div id="technical-tab" class="tab-content">
                <div class="section">
                    <div class="section-title">⚙️ Technical Specifications</div>
                    
                    <div class="field-group">
                        <div class="field">
                            <div class="field-label">Attestation Format</div>
                            <div class="field-value">SD-JWT VC (Selective Disclosure JWT Verifiable Credential)</div>
                        </div>
                        <div class="field">
                            <div class="field-label">Credential Type</div>
                            <div class="field-value">uri:eu.eudi.vat.1</div>
                        </div>
                        <div class="field">
                            <div class="field-label">Legal Category</div>
                            <div class="field-value">QEAA (Qualified Electronic Attestation of Attributes)</div>
                        </div>
                        <div class="field">
                            <div class="field-label">Holder Binding</div>
                            <div class="field-value">Non-device-bound (can be issued to intermediary with mandate)</div>
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-box-title">🔒 Selective Disclosure Attributes</div>
                        <div class="info-box-content">
                            The following attributes <strong>MUST</strong> be selectively disclosable:
                            <ul>
                                <li>Organisation type</li>
                                <li>Address components (all fields)</li>
                                <li>Economic operator details (legal_identifier, legal_name, or natural person data)</li>
                                <li>Economic activity details</li>
                                <li>Validity period dates</li>
                            </ul>
                            <br>
                            The following attributes <strong>MUST NOT</strong> be selectively disclosable (always visible):
                            <ul>
                                <li>VAT ID</li>
                                <li>Administrative unit name</li>
                                <li>Registered for EU cross-border transactions flag</li>
                                <li>Issuer metadata (country, authority, dates)</li>
                            </ul>
                        </div>
                    </div>

                    <div class="info-box" style="background: #fff3e0; border-left-color: #ff9800;">
                        <div class="info-box-title" style="color: #e65100;">⚠️ Verification Requirements</div>
                        <div class="info-box-content">
                            Relying parties <strong>SHOULD</strong>:
                            <ul>
                                <li>Check attestation revocation status and expiry date</li>
                                <li>Verify the validity period matches current date</li>
                                <li>Confirm Economic Operator identity matches wallet owner OR valid mandate exists</li>
                                <li>If mandate used: verify mandate is not revoked and currently valid</li>
                            </ul>
                            <br>
                            <strong>Note:</strong> Attestation is non-device-bound. Presenting the attestation alone does NOT prove ownership. Always verify Economic Operator identity or mandate.
                        </div>
                    </div>

                    <div class="field">
                        <div class="field-label">Revocation Mechanism</div>
                        <div class="field-value">Status List (status-list credential with revocation bitstring)</div>
                    </div>

                    <div class="field">
                        <div class="field-label">Trust Anchor Location</div>
                        <div class="field-value">https://trust.belastingdienst.nl/vat-attestations/trust-anchor</div>
                    </div>

                    <div class="field">
                        <div class="field-label">Rulebook</div>
                        <div class="field-value">WE BUILD rb-vat-id v0.97 (2026-09-03)</div>
                    </div>

                    <div class="field">
                        <div class="field-label">EBWV Version</div>
                        <div class="field-value">v0.1</div>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">📊 Integrity Rules</div>
                    
                    <div class="activity-card">
                        <div class="activity-code">EO1</div>
                        <div class="activity-desc">
                            <strong>Rule:</strong> Exactly one of legal_person or natural_person SHALL be present<br>
                            <strong>Rationale:</strong> Only one reference to wallet holder allowed to prevent inconsistencies
                        </div>
                    </div>

                    <div class="activity-card">
                        <div class="activity-code">VP1</div>
                        <div class="activity-desc">
                            <strong>Rule:</strong> If end_date exists, it SHALL be greater than start_date<br>
                            <strong>Rationale:</strong> Validity periods cannot be negative
                        </div>
                    </div>

                    <div class="activity-card">
                        <div class="activity-code">VP2</div>
                        <div class="activity-desc">
                            <strong>Rule:</strong> Validity periods SHALL NOT overlap<br>
                            <strong>Rationale:</strong> Prevents confusion for relying parties
                        </div>
                    </div>

                    <div class="activity-card">
                        <div class="activity-code">EA1</div>
                        <div class="activity-desc">
                            <strong>Rule:</strong> If local nomenclature ID equals NACE ID, use NACE<br>
                            <strong>Rationale:</strong> NACE is default nomenclature for EU interoperability
                        </div>
                    </div>

                    <div class="activity-card">
                        <div class="activity-code">XB1</div>
                        <div class="activity-desc">
                            <strong>Rule:</strong> If issuing_country not in EU, registered_eu_cross_border_transactions SHOULD be false<br>
                            <strong>Rationale:</strong> Only EU countries participate in VAT cross-border registration
                        </div>
                    </div>
                </div>

                <div class="button-group">
                    <button class="button" onclick="showTab('human')">← Human-Readable View</button>
                    <button class="button" onclick="showTab('json')">View W3C VC JSON →</button>
                </div>
            </div>

            <div id="json-tab" class="tab-content">
                <div class="section">
                    <div class="section-title">💻 W3C Verifiable Credential (JSON-LD)</div>
                    <div class="credential-json">
<span class="json-key">{</span>
  <span class="json-key">"@context"</span>: [
    <span class="json-string">"https://www.w3.org/ns/credentials/v2"</span>,
    <span class="json-string">"https://w3id.org/ebwv/v1"</span>,
    <span class="json-string">"https://w3id.org/security/suites/jws-2020/v1"</span>
  ],
  <span class="json-key">"id"</span>: <span class="json-string">"urn:uuid:8f7e4d3c-2b1a-4f6e-9c8d-7a5b3e2f1c0d"</span>,
  <span class="json-key">"type"</span>: [
    <span class="json-string">"VerifiableCredential"</span>,
    <span class="json-string">"VATIdentification"</span>
  ],
  <span class="json-key">"issuer"</span>: {
    <span class="json-key">"id"</span>: <span class="json-string">"did:web:trust.belastingdienst.nl"</span>,
    <span class="json-key">"name"</span>: <span class="json-string">"Dutch Tax and Customs Administration"</span>,
    <span class="json-key">"country"</span>: <span class="json-string">"NL"</span>
  },
  <span class="json-key">"issuanceDate"</span>: <span class="json-string">"2026-09-07T10:30:00Z"</span>,
  <span class="json-key">"expirationDate"</span>: <span class="json-string">"2027-09-07T10:30:00Z"</span>,
  <span class="json-key">"credentialSubject"</span>: {
    <span class="json-key">"id"</span>: <span class="json-string">"did:ebwv:NLKVK.90517428"</span>,
    <span class="json-key">"type"</span>: <span class="json-string">"VATRegistration"</span>,
    
    <span class="json-key">"administrativeUnit"</span>: {
      <span class="json-key">"type"</span>: <span class="json-string">"ebwv:VATRegistrationUnit"</span>,
      <span class="json-key">"ebwv:identifier"</span>: <span class="json-string">"NL123456789B01"</span>,
      <span class="json-key">"schema:name"</span>: <span class="json-string">"TechFlow Solutions B.V."</span>,
      <span class="json-key">"ebwv:type"</span>: <span class="json-string">"Besloten Vennootschap (B.V.)"</span>,
      <span class="json-key">"registeredEUCrossBorderTransactions"</span>: <span class="json-boolean">true</span>,
      
      <span class="json-key">"validityPeriod"</span>: {
        <span class="json-key">"ebwv:startDate"</span>: <span class="json-string">"2020-03-15"</span>,
