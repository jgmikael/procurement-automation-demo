  },
  
  <span class="json-key">"credentialStatus"</span>: {
    <span class="json-key">"type"</span>: <span class="json-string">"StatusList2021Entry"</span>,
    <span class="json-key">"statusPurpose"</span>: <span class="json-string">"revocation"</span>,
