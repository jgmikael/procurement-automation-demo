<https://jgmikael.github.io/procurement-automation-demo/event-ecosystem-lab/data/trade.ttl> a owl:Ontology ; rdfs:label "UBL 2.4 trade document profile"@en ; rdfs:seeAlso <https://iri.suomi.fi/model/busdoc/> .
trade:Catalogue a owl:Class ; rdfs:label "UBL Catalogue"@en ; rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.4/xsd/maindoc/UBL-Catalogue-2.4.xsd> .
trade:CatalogueCredential a owl:Class .
trade:Quotation a owl:Class ; rdfs:label "UBL Quotation"@en ; rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.4/xsd/maindoc/UBL-Quotation-2.4.xsd> .
trade:QuotationCredential a owl:Class .
trade:OrderResponse a owl:Class ; rdfs:label "UBL OrderResponse"@en ; rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.4/xsd/maindoc/UBL-OrderResponse-2.4.xsd> .
trade:OrderResponseCredential a owl:Class .
trade:Order a owl:Class ; rdfs:label "UBL Order"@en ; rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.4/xsd/maindoc/UBL-Order-2.4.xsd> .
trade:OrderCredential a owl:Class .
trade:Invoice a owl:Class ; rdfs:label "UBL Invoice"@en ; rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.4/xsd/maindoc/UBL-Invoice-2.4.xsd> .
trade:InvoiceCredential a owl:Class .
trade:DespatchAdvice a owl:Class ; rdfs:label "UBL DespatchAdvice"@en ; rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.4/xsd/maindoc/UBL-DespatchAdvice-2.4.xsd> .
trade:DespatchAdviceCredential a owl:Class .
trade:ReceiptAdvice a owl:Class ; rdfs:label "UBL ReceiptAdvice"@en ; rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.4/xsd/maindoc/UBL-ReceiptAdvice-2.4.xsd> .
trade:ReceiptAdviceCredential a owl:Class .
trade:Waybill a owl:Class ; rdfs:label "UBL Waybill"@en ; rdfs:seeAlso <https://docs.oasis-open.org/ubl/os-UBL-2.4/xsd/maindoc/UBL-Waybill-2.4.xsd> .
trade:WaybillCredential a owl:Class .
