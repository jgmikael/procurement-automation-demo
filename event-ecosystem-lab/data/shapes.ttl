@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ebwv: <https://w3id.org/ebwv#> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix elig: <https://jgmikael.github.io/procurement-automation-demo/event-ecosystem-lab/data/eligibility.ttl#> .
@prefix trade: <https://jgmikael.github.io/procurement-automation-demo/event-ecosystem-lab/data/trade.ttl#> .
@prefix busdoc: <https://iri.suomi.fi/model/busdoc/> .

# Validate the credentialSubject RDF node after JSON-LD expansion.
# These shapes do not check signatures, trust, legal eligibility or Peppol XML conformance.
<https://jgmikael.github.io/procurement-automation-demo/event-ecosystem-lab/data/shapes.ttl> a owl:Ontology ; rdfs:label "Synthetic VC subject shapes v0.1"@en .

elig:OperatorShape a sh:NodeShape ; sh:class ebwv:Company ;
    sh:property [ sh:path ebwv:legalName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ebwv:legalIdentifier ; sh:minCount 1 ; sh:maxCount 1 ] .

# EUCC limited liability company profile (WE BUILD rb-eucc, sections 2 and 3.3).
# EUCC's legalRepresentativeId semantic reference is absent from current EBWV;
# no such EBWV term is invented here. Synthetic persons omit optional identifiers.
elig:EUCCAddressShape a sh:NodeShape ; sh:class ebwv:Address ;
    sh:property [ sh:path ebwv:fullAddress ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

elig:EUCCRepresentativeShape a sh:NodeShape ; sh:class ebwv:LegalRepresentative ;
    sh:property [ sh:path ebwv:scopeOfAuthorization ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:nodeKind sh:IRI ; sh:in ( ebwv:Alone ebwv:Jointly ) ] ;
    sh:or ( [ sh:property [ sh:path ebwv:scopeOfAuthorization ; sh:hasValue ebwv:Alone ] ]
            [ sh:property [ sh:path ebwv:scopeOfAuthorization ; sh:hasValue ebwv:Jointly ] ;
              sh:property [ sh:path elig:jointSignatureCount ; sh:minCount 1 ;
                            sh:datatype xsd:integer ; sh:minInclusive 2 ] ;
              sh:property [ sh:path elig:signatoryGroup ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ] ) ;
    sh:or ( [ sh:class ebwv:Person ;
              sh:property [ sh:path ebwv:fullName ; sh:minCount 1 ; sh:datatype xsd:string ] ;
              sh:property [ sh:path ebwv:dateOfBirth ; sh:minCount 1 ; sh:datatype xsd:date ] ]
            [ sh:class ebwv:EconomicOperator ;
              sh:property [ sh:path ebwv:legalName ; sh:minCount 1 ] ;
              sh:property [ sh:path ebwv:legalIdentifier ; sh:minCount 1 ] ;
              sh:property [ sh:path ebwv:legalForm ; sh:minCount 1 ] ] ) .

elig:CompanyRegistrationShape a sh:NodeShape ; sh:targetClass elig:CompanyRegistration ;
    sh:class ebwv:LimitedLiabilityCompany ;
    sh:property [ sh:path ebwv:legalName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ebwv:legalIdentifier ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype ebwv:Euid ; sh:pattern "^[A-Z]{2}-[A-Z0-9]+-[A-Z0-9-]+$" ] ;
    sh:property [ sh:path ebwv:legalForm ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ebwv:jurisdiction ; sh:minCount 1 ; sh:pattern "^[A-Z]{2}$" ] ;
    sh:property [ sh:path ebwv:registeredAddress ; sh:minCount 1 ; sh:node elig:EUCCAddressShape ] ;
    sh:property [ sh:path ebwv:dateOfRegistration ; sh:minCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path ebwv:legalStatus ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ebwv:activity ; sh:minCount 1 ; sh:datatype ebwv:Nace21 ] ;
    sh:property [ sh:path ebwv:legalRepresentative ; sh:minCount 1 ; sh:node elig:EUCCRepresentativeShape ] .

elig:RepresentationAuthorityShape a sh:NodeShape ; sh:targetClass elig:RepresentationAuthority ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path elig:representativeName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:scope ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:authorityStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "ACTIVE" "INACTIVE" "UNKNOWN" ) ] ;
    sh:property [ sh:path elig:asOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

elig:TaxComplianceShape a sh:NodeShape ; sh:targetClass elig:TaxCompliance ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path elig:complianceStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "CLEAR" "ACTIVE" "NOT_CLEAR" "UNKNOWN" ) ] ;
    sh:property [ sh:path elig:jurisdiction ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:asOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

elig:SocialSecurityComplianceShape a sh:NodeShape ; sh:targetClass elig:SocialSecurityCompliance ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ebwv:complianceStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "CLEAR" "ACTIVE" "NOT_CLEAR" "UNKNOWN" ) ] ;
    sh:property [ sh:path elig:jurisdiction ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:asOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

elig:InsolvencyStatusShape a sh:NodeShape ; sh:targetClass elig:InsolvencyStatus ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path elig:proceedingStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:asOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

elig:ExclusionCheckShape a sh:NodeShape ; sh:targetClass elig:ExclusionCheck ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path elig:scope ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:checkOutcome ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:asOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

elig:FinancialCapacityShape a sh:NodeShape ; sh:targetClass elig:FinancialCapacity ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path elig:annualTurnover ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path elig:currencyCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:periodStart ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path elig:periodEnd ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path elig:insuranceLimit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] .

elig:ProfessionalAuthorisationShape a sh:NodeShape ; sh:targetClass elig:ProfessionalAuthorisation ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path elig:registerName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:licenceIdentifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:licenceStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "ACTIVE" "INACTIVE" "UNKNOWN" ) ] ;
    sh:property [ sh:path elig:asOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

elig:TechnicalCapacityShape a sh:NodeShape ; sh:targetClass elig:TechnicalCapacity ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path elig:referenceProject ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:deliveredValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path elig:currencyCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:qualificationStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

elig:OperatorOriginShape a sh:NodeShape ; sh:targetClass elig:OperatorOrigin ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path elig:establishmentCountry ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:asOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

trade:DocumentShape a sh:NodeShape ; sh:property [ sh:path busdoc:iD ; sh:minCount 1 ; sh:datatype xsd:string ] ; sh:property [ sh:path busdoc:issueDate ; sh:minCount 1 ; sh:datatype xsd:date ] .
trade:ItemShape a sh:NodeShape ; sh:class busdoc:Item ; sh:property [ sh:path busdoc:name ; sh:minCount 1 ; sh:datatype xsd:string ] .

trade:CatalogueShape a sh:NodeShape ; sh:targetClass trade:Catalogue ; sh:node trade:DocumentShape ; sh:property [ sh:path busdoc:sellerSupplierParty ; sh:minCount 1 ; sh:class busdoc:SupplierParty ] ; sh:property [ sh:path busdoc:buyerCustomerParty ; sh:minCount 1 ; sh:class busdoc:CustomerParty ] ; sh:property [ sh:path busdoc:catalogueLine_ ; sh:minCount 1 ; sh:class busdoc:CatalogueLine ; sh:property [ sh:path busdoc:item_ ; sh:minCount 1 ; sh:node trade:ItemShape ] ; sh:property [ sh:path busdoc:requiredItemLocationQuantity ; sh:minCount 1 ; sh:class busdoc:ItemLocationQuantity ; sh:property [ sh:path busdoc:price_ ; sh:minCount 1 ; sh:class busdoc:Price ] ] ] .

trade:QuotationShape a sh:NodeShape ; sh:targetClass trade:Quotation ; sh:node trade:DocumentShape ; sh:property [ sh:path busdoc:sellerSupplierParty ; sh:minCount 1 ; sh:class busdoc:SupplierParty ] ; sh:property [ sh:path busdoc:buyerCustomerParty ; sh:minCount 1 ; sh:class busdoc:CustomerParty ] ; sh:property [ sh:path trade:quotationLine ; sh:minCount 1 ; sh:class busdoc:QuotationLine ; sh:property [ sh:path trade:lineItem ; sh:minCount 1 ; sh:class busdoc:LineItem ; sh:property [ sh:path busdoc:item_ ; sh:minCount 1 ; sh:node trade:ItemShape ] ; sh:property [ sh:path busdoc:quantity ; sh:minCount 1 ; sh:datatype xsd:decimal ] ] ] .

elig:AwardDecisionShape a sh:NodeShape ; sh:targetClass epo:AwardDecision ; sh:property [ sh:path elig:decisionID ; sh:minCount 1 ] ; sh:property [ sh:path elig:issueDate ; sh:minCount 1 ; sh:datatype xsd:date ] ; sh:property [ sh:path elig:decisionFor ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ; sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ; sh:property [ sh:path elig:decisionOutcome ; sh:hasValue "AWARDED" ] .

trade:OrderResponseShape a sh:NodeShape ; sh:targetClass trade:OrderResponse ; sh:node trade:DocumentShape ; sh:property [ sh:path busdoc:sellerSupplierParty ; sh:minCount 1 ; sh:class busdoc:SupplierParty ] ; sh:property [ sh:path busdoc:buyerCustomerParty ; sh:minCount 1 ; sh:class busdoc:CustomerParty ] ; sh:property [ sh:path trade:orderReference ; sh:minCount 1 ; sh:class busdoc:OrderReference ; sh:property [ sh:path busdoc:iD ; sh:minCount 1 ] ] ; sh:property [ sh:path trade:orderResponseCode ; sh:hasValue "ACCEPTED" ] .

trade:OrderShape a sh:NodeShape ; sh:targetClass trade:Order ; sh:node trade:DocumentShape ; sh:property [ sh:path busdoc:sellerSupplierParty ; sh:minCount 1 ; sh:class busdoc:SupplierParty ] ; sh:property [ sh:path busdoc:buyerCustomerParty ; sh:minCount 1 ; sh:class busdoc:CustomerParty ] ; sh:property [ sh:path busdoc:orderLine_ ; sh:minCount 1 ; sh:class busdoc:OrderLine ; sh:property [ sh:path busdoc:lineItem_ ; sh:minCount 1 ; sh:class busdoc:LineItem ] ] .

trade:InvoiceShape a sh:NodeShape ; sh:targetClass trade:Invoice ; sh:node trade:DocumentShape ; sh:property [ sh:path busdoc:sellerSupplierParty ; sh:minCount 1 ; sh:class busdoc:SupplierParty ] ; sh:property [ sh:path busdoc:buyerCustomerParty ; sh:minCount 1 ; sh:class busdoc:CustomerParty ] ; sh:property [ sh:path busdoc:invoiceLine_ ; sh:minCount 1 ; sh:class busdoc:InvoiceLine ; sh:property [ sh:path busdoc:item_ ; sh:minCount 1 ; sh:node trade:ItemShape ] ; sh:property [ sh:path busdoc:invoicedQuantity ; sh:minCount 1 ; sh:datatype xsd:string ] ] ; sh:property [ sh:path busdoc:legalMonetaryTotal ; sh:minCount 1 ; sh:class busdoc:MonetaryTotal ; sh:property [ sh:path busdoc:payableAmount ; sh:minCount 1 ; sh:datatype xsd:decimal ] ] .

trade:DespatchAdviceShape a sh:NodeShape ; sh:targetClass trade:DespatchAdvice ; sh:node trade:DocumentShape ; sh:property [ sh:path busdoc:sellerSupplierParty ; sh:minCount 1 ; sh:class busdoc:SupplierParty ] ; sh:property [ sh:path busdoc:buyerCustomerParty ; sh:minCount 1 ; sh:class busdoc:CustomerParty ] ; sh:property [ sh:path trade:despatchLine ; sh:minCount 1 ; sh:class busdoc:DespatchLine ; sh:property [ sh:path busdoc:item_ ; sh:minCount 1 ; sh:node trade:ItemShape ] ; sh:property [ sh:path busdoc:deliveredQuantity ; sh:minCount 1 ; sh:datatype xsd:decimal ] ] .

trade:ReceiptAdviceShape a sh:NodeShape ; sh:targetClass trade:ReceiptAdvice ; sh:node trade:DocumentShape ; sh:property [ sh:path busdoc:sellerSupplierParty ; sh:minCount 1 ; sh:class busdoc:SupplierParty ] ; sh:property [ sh:path busdoc:buyerCustomerParty ; sh:minCount 1 ; sh:class busdoc:CustomerParty ] ; sh:property [ sh:path trade:receiptLine ; sh:minCount 1 ; sh:class busdoc:ReceiptLine ; sh:property [ sh:path busdoc:item_ ; sh:minCount 1 ; sh:node trade:ItemShape ] ; sh:property [ sh:path busdoc:receivedQuantity ; sh:minCount 1 ; sh:datatype xsd:decimal ] ] .

trade:WaybillShape a sh:NodeShape ; sh:targetClass trade:Waybill ; sh:node trade:DocumentShape ; sh:property [ sh:path busdoc:carrierParty ; sh:minCount 1 ] ; sh:property [ sh:path busdoc:shipment_ ; sh:minCount 1 ; sh:class busdoc:Shipment ] .

