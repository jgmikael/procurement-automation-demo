@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ebwv: <https://w3id.org/ebwv#> .
@prefix epo: <http://data.europa.eu/a4g/ontology#> .
@prefix elig: <https://jgmikael.github.io/procurement-automation-demo/event-ecosystem-lab/data/eligibility.ttl#> .
@prefix trade: <https://jgmikael.github.io/procurement-automation-demo/event-ecosystem-lab/data/trade.ttl#> .

# Validate the credentialSubject RDF node after JSON-LD expansion.
# These shapes do not check signatures, trust, legal eligibility or Peppol XML conformance.
<https://jgmikael.github.io/procurement-automation-demo/event-ecosystem-lab/data/shapes.ttl> a owl:Ontology ; rdfs:label "Synthetic VC subject shapes v0.1"@en .

elig:OperatorShape a sh:NodeShape ; sh:class ebwv:Company ;
    sh:property [ sh:path ebwv:legalName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ebwv:legalIdentifier ; sh:minCount 1 ; sh:maxCount 1 ] .

elig:CompanyRegistrationShape a sh:NodeShape ; sh:targetClass elig:CompanyRegistration ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path elig:registrationStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "ACTIVE" "INACTIVE" "UNKNOWN" ) ] ;
    sh:property [ sh:path elig:asOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

elig:RepresentationAuthorityShape a sh:NodeShape ; sh:targetClass elig:RepresentationAuthority ;
    sh:property [ sh:path elig:economicOperator ; sh:minCount 1 ; sh:maxCount 1 ; sh:node elig:OperatorShape ] ;
    sh:property [ sh:path elig:appliesToLot ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path elig:representativeName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:scope ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path elig:authorityStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "ACTIVE" "INACTIVE" "UNKNOWN" ) ] ;
    sh:property [ sh:path elig:asOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] .

